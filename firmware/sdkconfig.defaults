# ESP-IDF settings for every board. Each board adds its own in
# boards/<board>/sdkconfig.defaults (flash size, PSRAM, console).

# The UI runs on the main task and renders text and JSON there.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Full speed; the boards run on USB power.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 ms tick so short sleeps in the UI loop are accurate.
CONFIG_FREERTOS_HZ=1000

# WiFi buffers and A-MPDU stay at ESP-IDF's defaults. Cutting them to save
# RAM made access points (seen with WPA3) queue frames for seconds: pings of
# 4-6 s and about 1.5 KB/s at full signal.
CONFIG_BT_ENABLED=n

# Updates over WiFi: a new firmware must connect once and mark itself valid,
# otherwise the bootloader goes back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The UI loop runs on the main task; put it on the second core, away from
# WiFi and the TCP/IP stack on core 0.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# Smaller firmware (measured on the ESP32: 1.61 MB -> 1.51 MB). Error names
# stay in the log (about 8 KB) as they make debugging much easier.
# C printf without float formatting; Rust formatting is unaffected.
CONFIG_NEWLIB_NANO_FORMAT=y
# ESP-IDF assertions still stop the device, without their message strings.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# IPv4 only; mDNS and the home network work without IPv6.
CONFIG_LWIP_IPV6=n
