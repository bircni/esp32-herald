# The UI runs on the main task and renders text and JSON there.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# 1 ms tick so short sleeps in the UI loop are accurate.
CONFIG_FREERTOS_HZ=1000

# 4 MB module, no OTA: one large application partition (see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# No PSRAM on this board: keep the WiFi stack's RAM use modest.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_BT_ENABLED=n
